import { Prisma } from "../../generated/prisma";
import { prisma } from "../../config/prisma";

export const createTransferRecord = async (
  data: {
    fromAccountId: string;
    toAccountId: string;
    amount: Prisma.Decimal;
    description?: string;
    occurredAt: Date;
  },
  tx?: Prisma.TransactionClient,
